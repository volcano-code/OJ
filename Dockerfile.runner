FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y g++ python3 nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /work /opt/algonote \
    && chmod 1777 /work

COPY algonote/runner_worker.py /opt/algonote/runner_worker.py
RUN chmod 0444 /opt/algonote/runner_worker.py
USER 65534:65534
WORKDIR /work
ENTRYPOINT ["python3", "-I", "-B", "/opt/algonote/runner_worker.py"]
