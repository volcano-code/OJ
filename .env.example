# Defaults to personal local access. Keep the real .env out of Git.
ALGONOTE_HOST=127.0.0.1
ALGONOTE_PORT=8000
ALGONOTE_DATA_DIR=data
ALGONOTE_NOTEBOOK_DIR=notebook
ALGONOTE_RUNNER_IMAGE=algonote-runner:0.1

# Required when binding to 0.0.0.0 or a LAN/public interface.
# Enter the same token in the website's Settings panel.
ALGONOTE_TOKEN=

# Optional AI service: an OpenAI-compatible chat/completions endpoint.
# The API address and model must match the provider you actually use.
# Example local provider URL: http://127.0.0.1:11434/v1
ALGONOTE_AI_BASE_URL=
ALGONOTE_AI_API_KEY=
ALGONOTE_AI_MODEL=
